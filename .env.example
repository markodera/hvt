# ==============================================================================
# HVT Environment Configuration Template
# ==============================================================================
# This file lists all the environment variables needed to run HVT.
# Copy this file to `.env` and fill in the values for your deployment.
# Absolutely DO NOT commit actual secrets or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------

# DEBUG mode. Set to 1 for development to see error tracebacks. 
# MUST be 0 in production for security.
# Required. Default: 0 in production, 1 in dev.
DEBUG=0

# A large random string used for cryptographic signing. Keep this secret!
# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Or:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated list of domains/IPs the API is allowed to serve.
# Required in production. Example: api.example.com,192.168.1.100.
# For local development with DEBUG=1, localhost/127.0.0.1 are automatically allowed.
ALLOWED_HOSTS=

# The URL of your primary frontend dashboard.
# Required for creating correct links (e.g. password reset emails, invite URLs).
# Example: https://app.example.com or http://localhost:5173
FRONTEND_URL=

# Comma-separated list of origins that are allowed to make cross-site HTTP requests (CORS).
# Required in production. Example: https://app.example.com,https://storefront.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated list of origins trusted for unsafe requests (POST, PUT, DELETE).
# Usually identical to CORS_ALLOWED_ORIGINS.
# Required in production. Example: https://app.example.com
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# Secret Encryption (MultiFernet)
# ------------------------------------------------------------------------------

# Comma-separated list of 32-byte base64-encoded Fernet encryption keys used for
# encrypting sensitive database fields at rest (TOTP secrets, social OAuth secrets).
# Required in production (DEBUG=0). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Multiple keys can be comma-separated for key rotation (first key encrypts, all keys decrypt).
HVT_ENCRYPTION_KEYS=

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------

# PostgreSQL container credentials (used by docker compose):
DB_NAME=hvt
DB_USER=hvt
DB_PASSWORD=

# The connection string for your PostgreSQL database.
# Required. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# When using docker compose, this is automatically configured to point to the db service.
# Example: postgres://hvt:supersecret@127.0.0.1:5432/hvt
DATABASE_URL=

# Redis URL for caching, rate limiting, and session coordination.
REDIS_URL=redis://127.0.0.1:6379/0

# Enables Redis for improved caching performance.
# Optional. Set to 1 to enable.
USE_REDIS_CACHE=1

# Run database migrations automatically when starting.
# Optional. Set to 1 if deploying via Docker or automated entrypoint scripts.
RUN_MIGRATIONS=1

# Run collectstatic automatically when starting.
# Optional. Set to 1 if deploying via Docker.
COLLECTSTATIC_ON_START=1

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------

# The email address that system emails (verification, reset, notifications) are sent from.
# Required if you want email functionality to work. Example: noreply@example.com
DEFAULT_FROM_EMAIL=noreply@example.com

# Resend API Key for sending system and transactional emails (optional).
RESEND_API_KEY=

# Resend Webhook signing secret for incoming email event webhooks (optional).
RESEND_WEBHOOK_SIGNING_KEY=

# ------------------------------------------------------------------------------
# Security Flags (Required 1 in Production, 0 in Development)
# ------------------------------------------------------------------------------

# Use the 'X-Forwarded-Host' header from a reverse proxy (e.g. Nginx, Cloudflare, Traefik).
# Required: Set to 1 if behind a reverse proxy.
USE_X_FORWARDED_HOST=1

# Forces all HTTP traffic to redirect to HTTPS.
# Required: Set to 1 in production. 0 for local development.
SECURE_SSL_REDIRECT=1

# Marks the session cookie as secure (requires HTTPS).
# Required: Set to 1 in production. 0 for local development.
SESSION_COOKIE_SECURE=1

# Marks the CSRF cookie as secure (requires HTTPS).
# Required: Set to 1 in production. 0 for local development.
CSRF_COOKIE_SECURE=1

# Marks JWT authentication cookies as secure (requires HTTPS).
# Required: Set to true in production. false for local development.
JWT_AUTH_SECURE=true

# Sets the SameSite policy for JWT cookies.
# Required: Can be set to 'Strict', 'Lax', or 'None'. Usually 'Lax' or 'None' in production.
JWT_AUTH_SAMESITE=Lax

# ------------------------------------------------------------------------------
# Feature Toggles & Admin Interface
# ------------------------------------------------------------------------------

# Enable the built-in Django Admin interface.
# Off by default in production (opt-in). Set to 1 to enable.
EXPOSE_ADMIN=0

# Custom URL path for Django Admin (only active if EXPOSE_ADMIN=1).
# Defaults to "admin/". Example: "custom-mgmt/" or "control-portal/"
DJANGO_ADMIN_PATH=admin/

# Enable OpenAPI documentation endpoints (/api/docs/ and /api/redoc/).
# Off by default in production (opt-in). Set to 1 to enable.
EXPOSE_API_DOCS=0
