# ==============================================================================
# HVT Environment Configuration Template
# ==============================================================================
# This file lists all the environment variables needed to run HVT.
# Copy this file to `.env` and fill in the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Settings
# ------------------------------------------------------------------------------

# DEBUG mode. Set to 1 for development to see error tracebacks. 
# MUST be 0 in production for security.
# Required. Default: 0 in production, 1 in dev.
DEBUG=

# A large random string used for cryptographic signing. Keep this secret!
# Required. Use `python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'` to generate one.
SECRET_KEY=

# Comma-separated list of domains/IPs the API is allowed to serve.
# Required in production. Example: api.example.com,192.168.1.100.
# For local development with DEBUG=1, localhost/127.0.0.1 are automatically allowed.
ALLOWED_HOSTS=

# The URL of your primary frontend dashboard.
# Required for creating correct links (e.g. password reset emails).
# Example: https://app.example.com or http://localhost:5173
FRONTEND_URL=

# Comma-separated list of origins that are allowed to make cross-site HTTP requests (CORS).
# Required in production. Example: https://app.example.com,https://docs.example.com
CORS_ALLOWED_ORIGINS=

# Comma-separated list of origins trusted for unsafe requests (POST, PUT).
# Usually identical to CORS_ALLOWED_ORIGINS.
# Required in production. Example: https://app.example.com
CSRF_TRUSTED_ORIGINS=

# ------------------------------------------------------------------------------
# Database & Cache
# ------------------------------------------------------------------------------

# The connection string for your PostgreSQL database.
# Required. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Example: postgres://hvt:supersecret@127.0.0.1:5432/hvt
DATABASE_URL=

# Enables Redis for improved caching performance.
# Optional. Set to 1 to enable. (Requires REDIS_URL if you changed default port).
USE_REDIS_CACHE=

# Run database migrations automatically when starting.
# Optional. Set to 1 if you want docker or scripts to apply schema changes automatically.
RUN_MIGRATIONS=

# Run collectstatic automatically when starting.
# Optional. Set to 1 if deploying via Docker or automated scripts.
COLLECTSTATIC_ON_START=

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------

# The email address that system emails (verification, reset, notifications) are sent from.
# Required if you want email functionality to work. Example: noreply@example.com
DEFAULT_FROM_EMAIL=

# ------------------------------------------------------------------------------
# Security Flags (Required 1 in Production, 0 in Development)
# ------------------------------------------------------------------------------

# Use the 'X-Forwarded-Host' header from a load balancer/proxy.
# Required: Set to 1 if using Nginx/Cloudflare as a reverse proxy.
USE_X_FORWARDED_HOST=

# Forces all HTTP traffic to redirect to HTTPS.
# Required: Set to 1 in production. 0 for local development.
SECURE_SSL_REDIRECT=

# Marks the session cookie as secure (requires HTTPS).
# Required: Set to 1 in production. 0 for local development.
SESSION_COOKIE_SECURE=

# Marks the CSRF cookie as secure (requires HTTPS).
# Required: Set to 1 in production. 0 for local development.
CSRF_COOKIE_SECURE=

# Marks JWT authentication cookies as secure (requires HTTPS).
# Required: Set to true in production. false for local development.
JWT_AUTH_SECURE=

# Sets the SameSite policy for JWT cookies.
# Required: Can be set to 'Strict', 'Lax', or 'None'. Usually 'None' or 'Lax' in production.
JWT_AUTH_SAMESITE=

# ------------------------------------------------------------------------------
# Feature Toggles
# ------------------------------------------------------------------------------

# Enable the built-in Django Admin interface (/admin/).
# Optional. Set to 1 to enable. Often disabled in strict environments.
EXPOSE_ADMIN=

# Enable the OpenAPI documentation endpoints (/api/docs/ and /api/redoc/).
# Optional. Set to 1 to enable, usually reserved for development only.
EXPOSE_API_DOCS=

# ------------------------------------------------------------------------------
# Asymmetric Cryptography (RS256 JWT Signing & Public JWKS)
# ------------------------------------------------------------------------------

# 2048-bit RSA Private Key in PEM format (or path to .pem file).
# Required in production (DEBUG=False) for asymmetric RS256 token signing.
# In dev/testing, an ephemeral key is generated in memory automatically.
# Generate a new private key with OpenSSL:
#   openssl genpkey -algorithm RSA -out private_key.pem -pkeyopt rsa_keygen_bits:2048
# Or with Python:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; from cryptography.hazmat.primitives import serialization; priv = rsa.generate_private_key(65537, 2048); print(priv.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace('\n', '\\n'))"
HVT_JWT_PRIVATE_KEY=

# Corresponding 2048-bit RSA Public Key in PEM format (or path to .pem file).
# Optional: automatically derived from HVT_JWT_PRIVATE_KEY if left blank.
HVT_JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# Secret Encryption (MultiFernet)
# ------------------------------------------------------------------------------

# Comma-separated list of 32-byte base64-encoded Fernet encryption keys used for
# encrypting sensitive database fields (e.g., social provider secrets).
# Required in production (DEBUG=False). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HVT_ENCRYPTION_KEYS=

# Resend API Key for sending system and transactional emails (optional).
RESEND_API_KEY=
