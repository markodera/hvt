[Unit]
Description=gunicorn daemon
Requires=hvt-gunicorn.socket
After=network.target

[Service]
User=hvt
Group=www-data
WorkingDirectory=/home/hvt/hvt
ExecStart=/home/hvt/hvt/venv/bin/gunicorn \
          --access-logfile - \
          --workers 3 \
          --bind unix:/home/hvt/hvt/hvt-gunicorn.sock \
          --pid /tmp/hvt-gunicorn.pid \
          hvt.wsgi:application

[Install]
WantedBy=multi-user.target